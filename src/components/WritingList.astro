---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing' | 'blog'>[];
  basePath?: string;
  showFullDate?: boolean;
}
const { posts, basePath = '/writing', showFullDate = false } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  ...(showFullDate ? { month: 'short' as const, day: 'numeric' as const } : {}),
  timeZone: 'UTC',
});
---

<ul class="writing">
  {
    posts.map((post) => (
      <li>
        <a href={`${basePath}/${post.id}/`} class="row">
          <span class="title">{post.data.title}</span>
          <time class="date" datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {dateFormatter.format(post.data.pubDate)}
          </time>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .writing {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 0.35rem;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    color: inherit;
  }
  .title {
    color: var(--fg);
    letter-spacing: -0.012em;
    transition: color 160ms var(--ease-out);
  }
  .date {
    color: var(--fg-faint);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      text-decoration: none;
    }
    .row:hover .title {
      color: var(--accent);
    }
  }
</style>
