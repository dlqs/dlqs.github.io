---
import { getCollection } from 'astro:content';
import BaseLayout from '../../src/layouts/BaseLayout.astro';
import WritingList from '../../src/components/WritingList.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Posts by Donald Lee." isHome>
  <section class="hero rise">
    <h1>Blog</h1>
    <p>Donald Lee</p>
  </section>
  <section class="block rise" style="--rise-delay: 80ms" aria-label="Posts">
    {posts.length ? <WritingList posts={posts} basePath="" showFullDate /> : <p class="empty">No posts yet.</p>}
  </section>
</BaseLayout>

<style>
  .hero h1 {
    font-size: 1.4rem;
    margin-bottom: 0.15rem;
  }
  .hero p {
    color: var(--fg-muted);
    margin: 1.1rem 0 0;
  }
  .block {
    margin-top: 3.5rem;
  }
  .empty {
    color: var(--fg-muted);
  }
</style>
